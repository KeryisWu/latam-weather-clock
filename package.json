{
  "name": "latam-weather-clock",
  "version": "1.0.0",
  "private": true,
  "description": "拉美运营时空台 Windows 桌面版",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@svg-maps/brazil": "2.0.0",
    "@svg-maps/mexico": "2.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^7.0.4"
  },
  "build": {
    "appId": "com.airwit.latamweatherclock",
    "productName": "拉美运营时空台",
    "asar": true,
    "files": [
      "electron-main.cjs",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "LatAm-Weather-Clock-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "拉美运营时空台",
      "deleteAppDataOnUninstall": false
    }
  }
}
